{
  "name": "my-agents",
  "private": true,
  "version": "1.0.0",
  "author": "Thiago Cariuska",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,app -c green,magenta \"vite --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "app": "vite build && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "dist": "vite build && electron-builder",
    "start": "vite build && node server/index.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Painel desktop das sessões e subagentes do Claude Code",
  "main": "electron/main.js",
  "build": {
    "appId": "dev.cariuska.myagents",
    "productName": "Meus agentes",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
